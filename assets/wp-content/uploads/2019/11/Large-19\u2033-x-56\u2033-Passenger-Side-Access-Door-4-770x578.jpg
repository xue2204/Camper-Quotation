    <!-- End Google Tag Manager (noscript) -->
    <script>document.addEventListener('DOMContentLoaded', function() {
  // Target the Build & Price CF7 form
  const targetForm = document.querySelector('.wpcf7[data-wpcf7-id="1129"] .wpcf7-form');
  if (!targetForm) return;

  const emailField = targetForm.querySelector('input[type="email"]');
  if (!emailField) return;

  const ZAP_URL = 'https://hooks.zapier.com/hooks/catch/21402431/u95m9co/';
  const FORM_ID = '8cb55f4'; // keep existing form_id
  const isValid = v => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);

  // helper to post as simple form data (avoids CORS preflight)
  function postToZap(fields) {
    const payload = new URLSearchParams(fields);
    const ok = navigator.sendBeacon && navigator.sendBeacon(ZAP_URL, payload);
    if (!ok) {
      fetch(ZAP_URL, {
        method: 'POST',
        mode: 'no-cors',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: payload.toString()
      }).catch(() => {});
    }
  }

  // 1) START signal (user typed email but hasn't submitted yet)
  let startSent = false; // de-dupe per page view
  function sendStartIfNeeded() {
    const email = (emailField.value || '').trim();
    if (!startSent && isValid(email)) {
      startSent = true;
      postToZap({
        email: email,
        source: 'camper_build_form',
        form_id: FORM_ID,
        timestamp: new Date().toISOString()
        // no "status" field = treated as "started"
      });
      console.log('[Abandon] start ping sent');
    }
  }
  emailField.addEventListener('blur', sendStartIfNeeded);
  emailField.addEventListener('change', sendStartIfNeeded);

  // 2) COMPLETED signal (form actually submitted)
  document.addEventListener('wpcf7mailsent', function(e) {
    // Only act if this event came from our targeted form
    if (!targetForm.contains(e.target)) return;

    const email = (emailField.value || '').trim();
    if (!isValid(email)) return;

    postToZap({
      email: email,
      status: 'completed',
      source: 'camper_build_form',
      form_id: FORM_ID,
      timestamp: new Date().toISOString()
    });
    console.log('[Abandon] completion ping sent');
  });
});
</script><noscript><img height="1" width="1" style="display: none;" src="https://www.facebook.com/tr?id=561557487545465&ev=PageView&noscript=1&cd%5Bpage_title%5D=Home&cd%5Bpost_type%5D=page&cd%5Bpost_id%5D=18766&cd%5Bplugin%5D=PixelYourSite&cd%5Buser_role%5D=guest&cd%5Bevent_url%5D=fourwheelcampers.com%2F" alt=""></noscript>
