<body class="home wp-singular page-template-default page page-id-18766 wp-custom-logo wp-theme-fourwh no-js has-hero white-header-bg">
<script type="text/javascript">
    document.body.className = document.body.className.replace("no-js","js");
</script>

<div class="wrapper">
    <a class="btn-jump-to-content smooth-scroll" href="#main-content">Skip Navigation</a>

    
    <header id="header-main" class="header">
        <div class="container">
            <div class="logo">
                <a href="https://fourwheelcampers.com" title="Four Wheel Campers">
                    <img class="skip_lazy" src="https://fourwheelcampers.com/wp-content/uploads/2025/07/4WC-Logo-BlueL.png" alt="Four Wheel Campers">
                </a>
            </div>
            <div class="mobile-menu-toggle">
                <span></span>
            </div>

            <span class="toggle-woo-category">
                <span>Categories</span>
                <i class="fas fa-th-large"></i>
            </span>

            <nav class="main-nav desktop"><ul><li id="menu-item-24199" class="menu-item menu-item-type-post_type menu-item-object-page menu-item-24199 menu-item-level-0"><a href="https://fourwheelcampers.com/all-models/">Camper Models</a><div class="sub-menu sub-menu-style-selector"><div class="section-choose-style-v2 default"><div class="section-heading">
                <div class="container">
                    <h2 class="h2">Select Your Platform</h2>
                </div>
            </div><div class="section-body"><div class="container"><ul class="all-models-list-v2"><li class="all-models-box-v2"><div class="v2-box-heading"><h3 class='h3'>Slide-in</h3><p class="subheading">Slides into truck bed</p></div><div class="v2-box-body"><div class="all-models-box-v2-img centered-img"><img width="600" height="400" src="https://fourwheelcampers.com/wp-content/uploads/2025/01/admin-ajax-slide-in-copy.jpg" class="attachment-large size-large" alt="Slide-in" decoding="async" srcset="https://fourwheelcampers.com/wp-content/uploads/2025/01/admin-ajax-slide-in-copy.jpg 600w, https://fourwheelcampers.com/wp-content/uploads/2025/01/admin-ajax-slide-in-copy-440x293.jpg 440w, https://fourwheelcampers.com/wp-content/uploads/2025/01/admin-ajax-slide-in-copy-300x200.jpg 300w, https://fourwheelcampers.com/wp-content/uploads/2025/01/admin-ajax-slide-in-copy-64x43.jpg 64w" sizes="(max-width: 600px) 100vw, 600px" /></div><div class="block-min-price">Starting at <span class="min-price">$19,495</span></div><p class="style-description">Our slide-in pop up camper that started it all. Over 50 years of fine tuning & perfecting have made this our most popular camper decade after decade.</p></div><div class="v2-box-footer"><div class="explore-link-box"><a href="https://fourwheelcampers.com/all-models/slide-in-popup-truck-campers/" class="btn btn-read-more" title="View Models">View Models</a></div></div></li><li class="all-models-box-v2"><div class="v2-box-heading"><h3 class='h3'>Flatbed</h3><p class="subheading">Remove bed & apply</p></div><div class="v2-box-body"><div class="all-models-box-v2-img centered-img"><img width="600" height="400" src="https://fourwheelcampers.com/wp-content/uploads/2025/01/admin-ajax-flatbed.jpg" class="attachment-large size-large" alt="Flatbed" decoding="async" srcset="https://fourwheelcampers.com/wp-content/uploads/2025/01/admin-ajax-flatbed.jpg 600w, https://fourwheelcampers.com/wp-content/uploads/2025/01/admin-ajax-flatbed-440x293.jpg 44